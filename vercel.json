{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://taskflow-u1j7.onrender.com/api/$1"
    },
    {
      "source": "/api-docs",
      "destination": "https://taskflow-u1j7.onrender.com/api-docs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}